{
  "name": "@hexpayroll/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Hex Payroll. Owns main + preload only; the renderer is apps/web.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build --ignoreConfigWarning",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "test:runtime": "node scripts/verify-runtime.mjs",
    "test:packaged": "node scripts/verify-packaged.mjs",
    "package": "electron-builder --config electron-builder.yml --win nsis --x64 --publish never",
    "package:rehearsal": "electron-builder --config electron-builder.yml --win nsis --x64 --publish never --config.forceCodeSigning=false"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3"
  }
}
