# Hex Payroll API — environment template.
# Copy to `.env` in this same directory (apps/api/.env) and fill in real values.
# `.env` is gitignored; this template is committed.

NODE_ENV=development

# Loopback only. The desktop's private API must not be reachable from the network.
API_HOST=127.0.0.1
API_PORT=4311

LOG_LEVEL=info

# Transport is opt-in. Central: SYNC_MODE=central. Desktop: enroll first, then local.
SYNC_MODE=disabled
SYNC_INTERVAL_MS=15000
# SYNC_CENTRAL_URL=https://payroll.example.com
# SYNC_NODE_ID=installation-uuid
# SYNC_NODE_TOKEN=secret-returned-once-at-registration

# Runtime role: SELECT/INSERT/UPDATE/DELETE only. Has NO right to alter schema.
DATABASE_URL=postgresql://hexpayroll_app:CHANGE_ME@127.0.0.1:5432/hexpayroll_dev

# Migration role: owns the schema. Used ONLY by the migration runner (Phase 1),
# never by the running API process.
MIGRATION_DATABASE_URL=postgresql://hexpayroll_migrator:CHANGE_ME@127.0.0.1:5432/hexpayroll_dev

# Test-only acceptance integration tests: configure in untracked .env.test after
# manually reviewing database/test/provision-acceptance-writer.sql. No runtime fallback.
# TEST_ACCEPTANCE_WRITER_DATABASE_URL=postgresql://hexpayroll_acceptance_test_writer:CHANGE_ME@127.0.0.1:5432/hexpayroll_test
# Opt-in local trusted v2 pull/application. Leave false until trusted actors and local conflicts are reviewed.
SYNC_TRUSTED_EVIDENCE_ENABLED=false
# Step 73N raw capture and central receipt. Requires reviewed source binding and both flags locally.
SYNC_BIOMETRIC_EVIDENCE_ENABLED=false
# Step 73N-B. Explicit reviewed source capabilities/coverage/policies and a separate
# central-only restricted writer are required. Never put writer credentials on a PC.
ATTENDANCE_FINALIZATION_ENABLED=false
# CENTRAL_ATTENDANCE_WRITER_DATABASE_URL=configure-only-on-reviewed-central-server
